# OpenList 集成配置示例
# 复制此文件为 .env 并填入实际值

# ============================================
# OpenList 连接配置
# ============================================

# OpenList 服务器地址（必填）
# 示例：http://localhost:5244 或 http://your-server:5244
OPENLIST_URL=http://localhost:5244

# OpenList API Token（必填）
# 在 OpenList 管理后台 -> 设置 -> 其他 -> 令牌 中获取
OPENLIST_TOKEN=your-token-here

# ============================================
# 网盘优化配置（强烈推荐）
# ============================================

# 忽略文件元数据变化（inode/mtime/ctime）
# 只通过路径和大小判断文件是否变动
# 对网盘挂载和 OpenList 存储非常重要
IGNORE_FILE_METADATA=true

# 快速扫描模式
# 只读取文件头部进行元数据提取，大幅提升扫描速度
FAST_SCAN_MODE=true

# 跳过嵌入章节扫描
# 减少文件读取，提升扫描速度
SKIP_EMBEDDED_CHAPTERS=true

# ============================================
# Audiobookshelf 基础配置
# ============================================

# 服务器端口
PORT=80

# 配置目录
CONFIG_PATH=/config

# 元数据目录
METADATA_PATH=/metadata

# ============================================
# 可选配置
# ============================================

# 日志级别（debug, info, warn, error）
# LOG_LEVEL=info

# 扫描并发数（默认 32，快速模式下为 64）
# SCAN_BATCH_SIZE=32

# ============================================
# Docker Compose 使用示例
# ============================================
# 
# version: '3.8'
# services:
#   audiobookshelf:
#     image: advplyr/audiobookshelf
#     env_file:
#       - .env
#     ports:
#       - 13378:80
#     volumes:
#       - ./config:/config
#       - ./metadata:/metadata
#
#   openlist:
#     image: xhofe/alist:latest
#     ports:
#       - 5244:5244
#     volumes:
#       - ./alist-data:/opt/alist/data

# ============================================
# 路径格式说明
# ============================================
#
# OpenList 路径使用 openlist:// 前缀：
# - openlist:///audiobooks          # OpenList 根目录下的 audiobooks
# - openlist:///115/我的有声书       # 115 网盘中的路径
# - openlist:///阿里云盘/Audiobooks  # 阿里云盘中的路径
#
# 本地路径保持原样：
# - /audiobooks                     # Linux/Mac 本地路径
# - C:/Audiobooks                   # Windows 本地路径

# ============================================
# 性能调优建议
# ============================================
#
# 1. 网络优化：
#    - 将 Audiobookshelf 和 OpenList 部署在同一网络
#    - 使用内网地址而不是公网地址
#
# 2. 扫描优化：
#    - 启用所有优化选项（见上方配置）
#    - 首次扫描选择网络空闲时段
#    - 使用自动扫描计划而不是手动扫描
#
# 3. 存储优化：
#    - 在 OpenList 中合理组织目录结构
#    - 每本书一个文件夹
#    - 避免过深的目录层级

# ============================================
# 故障排查
# ============================================
#
# 测试 OpenList 连接：
#   curl http://localhost:5244/ping
#
# 测试 API Token：
#   curl -H "Authorization: Bearer your-token" \
#        http://localhost:5244/api/public/settings
#
# 运行集成测试：
#   node server/utils/testOpenList.js /your/path
#
# 查看日志：
#   docker logs audiobookshelf | grep OpenList
